# Copia este archivo como ".env" y completa tus propios valores.
# NUNCA subas el archivo ".env" real a GitHub.

# Cadena de conexión de MongoDB Atlas (o local)
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=eleccion_rey_reina

# Credenciales del administrador
# ADMIN_PASSWORD_HASH se genera con seed.py (ver README) — nunca escribas la contraseña en texto plano.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Clave secreta para firmar los tokens JWT. Genera una aleatoria y larga.
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-y-larga

# Dominios permitidos para CORS en producción, separados por coma.
# En desarrollo puedes dejar "*"
ALLOWED_ORIGINS=*
